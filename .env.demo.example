# ==============================================================================
# VIRALCUE DEMO ENVIRONMENT VARIABLES
# ==============================================================================
# Use this file to configure the Managed Serverless Split deployment for the demo.
# Note: For Vercel frontend, copy the NEXT_PUBLIC_* variables to Vercel's dashboard.
# For Cloud Run backend services, copy the other variables to your Secret Manager
# or Cloud Run environment variables.

NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. CORE API & FRONTEND
# ------------------------------------------------------------------------------
# Auto-generated Cloud Run URL for the API service (e.g. https://viralcue-api-xxxxx.run.app)
FRONTEND_URL=https://clausync-demo.davman.dev
NEXT_PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# 2. MANAGED DATABASES (Free Tiers)
# ------------------------------------------------------------------------------
# Neon.tech PostgreSQL URLs
DATABASE_URL="postgresql://[user]:[password]@[endpoint]-pooler.aws.neon.tech/viralcue?sslmode=require"
DIRECT_URL="postgresql://[user]:[password]@[endpoint].aws.neon.tech/viralcue?sslmode=require"

# Upstash Serverless Redis URL (Must use rediss:// for TLS)
REDIS_URL="rediss://default:[password]@[endpoint].upstash.io:6379"

# ------------------------------------------------------------------------------
# 3. GCP MANAGED SERVICES (Always Free Tier)
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=clausync-demo
NEXT_PUBLIC_GCP_PROJECT_ID=clausync-demo
GCP_REGION=us-central1

# Disable emulators to use real GCP services
USE_GCP_PUBSUB=true
PUBSUB_EMULATOR_HOST=
USE_FIRESTORE_DRAFTS=true
FIRESTORE_EMULATOR_HOST=
USE_GCS_STORAGE=true
STORAGE_EMULATOR_HOST=

# GCS Buckets (Must be globally unique)
RAW_CLIPS_BUCKET=viralcue-raw-clips-clausync-demo
PROCESSED_CLIPS_BUCKET=viralcue-processed-clips-clausync-demo
THUMBNAILS_BUCKET=viralcue-thumbnails-clausync-demo

# ------------------------------------------------------------------------------
# 4. CLERK AUTHENTICATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ------------------------------------------------------------------------------
# 5. AI ENGINE & DEEPGRAM
# ------------------------------------------------------------------------------
# Deepgram API key for speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# AI Provider Configuration (Using Gemini API from Google AI Studio)
LLM_PROVIDER=vertex_ai
USE_VERTEX_AI=true
# (Set GEMINI_API_KEY in the Cloud Run service environment if using direct API,
# or ensure the Cloud Run service account has Vertex AI User permissions)
VERTEX_AI_PROJECT=clausync-demo
VERTEX_AI_LOCATION=us-central1

# ------------------------------------------------------------------------------
# 6. INTERNAL SERVICE COMMUNICATION
# ------------------------------------------------------------------------------
# Secure key for service-to-service calls (generate a random string)
INTERNAL_API_KEY=

# Auto-generated Cloud Run URL for HLS Fetcher
HLS_FETCHER_URL=

# ------------------------------------------------------------------------------
# 7. PLATFORM OAUTH CREDENTIALS (for users to connect accounts)
# ------------------------------------------------------------------------------
# Redirect URIs should point to: {NEXT_PUBLIC_API_URL}/api/auth/callback/{provider}

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

META_CLIENT_ID=
META_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

# ------------------------------------------------------------------------------
# 8. STRIPE (Optional for demo)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

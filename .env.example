# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/viralcue

# ===========================================
# CLERK (Authentication)
# ===========================================
# Frontend (apps/web/.env.local) - publishable key only
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Frontend
FRONTEND_URL="http://localhost:3000"
# Backend (services/api/.env) - secret key only
CLERK_SECRET_KEY=sk_test_your_secret_key

# ===========================================
# TWITCH (Platform Connection)
# ===========================================
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret
TWITCH_REDIRECT_URI=http://localhost:3001/api/auth/callback/twitch

#============================================
# KICK (Platform Connection)
#============================================
KICK_CLIENT_ID="your_client_id"
KICK_CLIENT_SECRET="your_client_secret"
KICK_REDIRECT_URI="http://localhost:3001/api/auth/kick/callback"


# ===========================================
# YOUTUBE (Google OAuth)
# ===========================================
YOUTUBE_CLIENT_ID=your_google_client_id
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/auth/callback/youtube

# ===========================================
# INSTAGRAM / THREADS (Meta OAuth)
# ===========================================
META_CLIENT_ID=your_meta_app_id
META_CLIENT_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/auth/callback/instagram

# ===========================================
# TIKTOK
# ===========================================
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:3001/api/auth/callback/tiktok

# ===========================================
# TWITTER / X
# ===========================================
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:3001/api/auth/callback/twitter

# ===========================================
# DEEPGRAM (Speech-to-Text)
# ===========================================
DEEPGRAM_API_KEY=your_deepgram_api_key

# ===========================================
# GCP (Google Cloud Platform)
# ===========================================
GCP_PROJECT_ID=viralcue-local
GCP_REGION=us-central1

# GCP Emulator Settings (for local development)
# Set these to connect to local emulators instead of production
PUBSUB_EMULATOR_HOST=localhost:8085
FIRESTORE_EMULATOR_HOST=localhost:8086
STORAGE_EMULATOR_HOST=http://localhost:4443

# Vertex AI (requires real GCP credentials for testing)
USE_VERTEX_AI=false
VERTEX_AI_PROJECT=your-gcp-project
VERTEX_AI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/application_default_credentials.json

# ===========================================
# STRIPE (Payments)
# ===========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable

# ===========================================
# CHROME EXTENSION (apps/extension/.env.development)
# ===========================================
PLASMO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
PLASMO_PUBLIC_CLERK_SYNC_HOST=http://localhost:3000

# ===========================================
# HLS FETCHER (services/hls-fetcher)
# ===========================================
# URL for API to communicate with HLS Fetcher
HLS_FETCHER_URL=http://localhost:3003

# Internal API key for service-to-service communication
INTERNAL_API_KEY=internal-dev-key

# ===========================================
# FEATURE FLAGS
# ===========================================
# GCP Migration Flags
USE_GCP_PUBSUB=true
USE_FIRESTORE_DRAFTS=false
USE_GCS_STORAGE=true

# Legacy AWS (deprecated - remove after migration)
# ENABLE_SQS_CONSUMER=false

# ===========================================
# AI CONFIGURATION
# ===========================================
# Local development fallback
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_ID=deepseek-v3.1:671b-cloud


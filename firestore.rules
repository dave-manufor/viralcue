rules_version = '2';

/**
 * Firestore Security Rules for ViralCue
 * 
 * Collections:
 * - users/{userId}/streams/{streamId}/cards/{cardId} - Real-time draft cards for Tinder-style UI
 */
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Managed via Admin SDK from API
      
      // Streams sub-collection
      match /streams/{streamId} {
        allow read: if isOwner(userId);
        allow write: if false; // Managed via Admin SDK
        
        // Cards sub-collection - the Tinder-style draft cards
        match /cards/{cardId} {
          // Users can read their own cards
          allow read: if isOwner(userId);
          
          // Users can update card status (approve/reject) only
          allow update: if isOwner(userId) 
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status'])
            && request.resource.data.status in ['approved', 'rejected'];
          
          // Only backend can create/delete cards (via Admin SDK)
          allow create, delete: if false;
        }
      }
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

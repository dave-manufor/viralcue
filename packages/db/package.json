{
  "name": "@viralcue/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "dev": "dotenv -e ../../.env -- prisma studio",
    "build": "tsc",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@google-cloud/kms": "^4.0.0",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.2",
    "dotenv-cli": "^7.3.0",
    "prisma": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
